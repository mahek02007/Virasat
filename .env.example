# Virasat Frontend — Environment Variables
# Copy this file to .env.local or .env (git-ignored) and fill in your Supabase project credentials.
# Never commit .env or any file with real secrets to version control.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Supabase Anon / Public Key (Safe for browser client use)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# FastAPI backend base URL (no trailing slash)
# Local dev default: http://localhost:8000
# Production: set to your deployed API URL
VITE_API_BASE_URL=http://localhost:8000
