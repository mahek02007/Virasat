# Virasat Backend — Environment Variables
# Copy this to .env and fill in values for production

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (SQLite) — no action needed, default is used
# DATABASE_URL=sqlite:///./virasat.db

# Production (Supabase/PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/virasat

# ── Gemini API (Phase 2 — AI Chat) ──────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Security ─────────────────────────────────────────────────────────────────
# SECRET_KEY=your_secret_key_here
